{
  "name": "WorkStudy",
  "short_name": "WorkStudy",
  "description": "150+ free unblocked browser games, cloud saves, leaderboard, themes and web utilities — no download required.",
  "version": "3.21.83",
  "start_url": "/WorkStudy/?source=pwa",
  "scope": "/WorkStudy/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#6b21a8",
  "lang": "en",
  "dir": "ltr",
  "categories": ["games", "entertainment", "utilities"],
  "id": "/WorkStudy/",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",

  "icons": [
    { "src": "img/icon-72.png",  "sizes": "72x72",   "type": "image/png", "purpose": "any" },
    { "src": "img/icon-96.png",  "sizes": "96x96",   "type": "image/png", "purpose": "any" },
    { "src": "img/icon-128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-152.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "img/icon-384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],

  "screenshots": [
    {
      "src": "img/screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "label": "WorkStudy Home",
      "form_factor": "wide"
    },
    {
      "src": "img/screenshot-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "label": "WorkStudy Mobile",
      "form_factor": "narrow"
    }
  ],

  "shortcuts": [
    {
      "name": "🎮 Games",
      "short_name": "Games",
      "description": "Browse all 150+ unblocked games",
      "url": "/WorkStudy/games/index.html?source=shortcut",
      "icons": [{ "src": "img/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "🏆 Leaderboard",
      "short_name": "Leaderboard",
      "description": "View the global leaderboard",
      "url": "/WorkStudy/pages/leaderboard.html?source=shortcut",
      "icons": [{ "src": "img/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "🌐 Website Viewer",
      "short_name": "Viewer",
      "description": "Browse websites through the viewer",
      "url": "/WorkStudy/pages/websie.html?source=shortcut",
      "icons": [{ "src": "img/icon-96.png", "sizes": "96x96" }]
    }
  ],

  "scope_extensions": [
    { "origin": "https://eymc-group.github.io" },
    { "origin": "https://workstudy-api.354271744.workers.dev" }
  ],

  "file_handlers": [
    {
      "action": "/WorkStudy/pages/file-runner.html",
      "accept": {
        "text/html": [".html", ".htm"],
        "text/css": [".css"],
        "text/javascript": [".js", ".ts", ".jsx", ".tsx"],
        "application/json": [".json"],
        "text/xml": [".xml", ".xhtml"],
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt", ".csv", ".yaml", ".yml", ".vue", ".sh", ".bash", ".zsh", ".bat", ".cmd", ".ps1", ".ini", ".conf", ".toml", ".env", ".log", ".cfg", ".properties", ".gitignore", ".htaccess", ".lock"],
        "application/zip": [".zip"],
        "application/x-rar-compressed": [".rar"],
        "application/x-7z-compressed": [".7z"],
        "application/x-tar": [".tar"],
        "application/gzip": [".gz", ".tgz"],
        "application/x-bzip2": [".bz2"],
        "application/x-xz": [".xz"],
        "application/vnd.android.package-archive": [".apk"],
        "application/xapk": [".xapk"],
        "application/apkm": [".apkm"],
        "application/aab": [".aab"],
        "application/apks": [".apks"],
        "application/x-msdownload": [".exe", ".msi", ".dll"],
        "application/x-apple-diskimage": [".dmg"],
        "application/octet-stream": [".bin", ".dat", ".img", ".rom", ".iso", ".deb", ".rpm", ".pkg", ".cab", ".sys", ".drv"],
        "application/x-executable": [".elf", ".out", ".run"],
        "image/svg+xml": [".svg"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "image/x-icon": [".ico"],
        "image/bmp": [".bmp"],
        "image/avif": [".avif"],
        "image/tiff": [".tiff", ".tif"],
        "image/vnd.adobe.photoshop": [".psd"],
        "audio/mpeg": [".mp3"],
        "audio/ogg": [".ogg", ".oga"],
        "audio/wav": [".wav"],
        "audio/flac": [".flac"],
        "audio/aac": [".aac", ".m4a"],
        "audio/opus": [".opus"],
        "audio/midi": [".mid", ".midi"],
        "video/mp4": [".mp4", ".m4v"],
        "video/webm": [".webm"],
        "video/ogg": [".ogv"],
        "video/quicktime": [".mov"],
        "video/x-msvideo": [".avi"],
        "video/x-matroska": [".mkv"],
        "video/x-ms-wmv": [".wmv"],
        "video/x-flv": [".flv"],
        "video/3gpp": [".3gp"],
        "font/woff": [".woff"],
        "font/woff2": [".woff2"],
        "font/ttf": [".ttf"],
        "font/otf": [".otf"],
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/rtf": [".rtf"],
        "application/epub+zip": [".epub"],
        "application/x-python": [".py"],
        "application/x-ruby": [".rb"],
        "text/x-go": [".go"],
        "text/x-rust": [".rs"],
        "text/x-c": [".c", ".h"],
        "text/x-c++": [".cpp", ".cc", ".cxx", ".hpp"],
        "text/x-java": [".java"],
        "text/x-swift": [".swift"],
        "text/x-kotlin": [".kt"],
        "text/x-php": [".php"]
      },
      "icons": [{ "src": "img/icon-96.png", "sizes": "96x96" }],
      "launch_type": "single-client"
    },
    {
      "action": "/WorkStudy/pages/notepad.html",
      "accept": {
        "text/plain": [".txt", ".log", ".md", ".markdown"]
      },
      "icons": [{ "src": "img/icon-96.png", "sizes": "96x96" }],
      "launch_type": "single-client"
    }
  ],

  "launch_handler": {
    "client_mode": ["focus-existing", "navigate-existing", "auto"]
  },

  "protocol_handlers": [
    {
      "protocol": "web+workstudy",
      "url": "/WorkStudy/pages/iframe.html?url=%s"
    }
  ],

  "edge_side_panel": {
    "preferred_width": 400
  },

  "note_taking": {
    "new_note_url": "/WorkStudy/pages/devtools.html"
  },

  "widgets": [
    {
      "name": "WorkStudy Quick Launch",
      "description": "Quick access to WorkStudy games and tools",
      "tag": "workstudy-quick",
      "template": "workstudy-widget",
      "ms_ac_template": "widgets/template.json",
      "data": "widgets/data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "img/screenshot-narrow.png",
          "sizes": "1080x1920",
          "label": "WorkStudy Widget"
        }
      ],
      "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }],
      "backgrounds": [{ "src": "img/icon-512.png", "sizes": "512x512" }],
      "auth": false,
      "update": 86400
    }
  ],

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.eymcgroup.workstudy",
      "id": "com.eymcgroup.workstudy"
    }
  ],
  "prefer_related_applications": false,

  "share_target": {
    "action": "/WorkStudy/pages/website.html",
    "method": "GET",
    "params": {
      "url": "url",
      "title": "title"
    }
  }
}
